// Command [[.Binary]] is a giode app.
package main

import (
	_ "embed"
	"fmt"
	"log"

	"github.com/mehran9675/giode"
)

// icon is the window icon. Replace assets/icon.png with your own; giode
// build also uses it for the app icon on every platform.
//
//go:embed assets/icon.png
var icon []byte

func main() {
	giode.UseGofont()

	// App state. Plain variables work: the view below is rebuilt after
	// every event. Use giode.NewState for values other goroutines set.
	count := 0

	increment := giode.Button("Count", giode.Styles{
		Background:   "theme.primary",
		Color:        "theme.onprimary",
		BorderRadius: 8,
	}).OnClick(func() { count++ })

	app := giode.New(giode.Config{
		Title:      "[[.Name]]",
		Resizable:  true,
		Background: "theme.background",
		Icon:       icon,
	})

	// The view: a function returning the UI for the current state.
	if err := app.Run(func() giode.Element {
		return giode.Stack(giode.Styles{Width: -1, Height: -1, Align: giode.AlignCenter, Justify: giode.JustifyCenter, Gap: 16},
			giode.Text("[[.Name]]", giode.Styles{Color: "theme.text", FontSize: 24}),
			giode.Text(fmt.Sprintf("Clicks: %d", count), giode.Styles{Color: "theme.muted"}),
			increment,
		)
	}); err != nil {
		log.Fatal(err)
	}
}
